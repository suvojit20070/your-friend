<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Root of the YF.* family so every dotted style has an explicit, existing parent. -->
    <style name="YF" />

    <style name="YF.Glass">
        <item name="android:background">@drawable/glass_card</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>

    <style name="YF.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="YF.Section">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>

    <style name="YF.Body">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="YF.Caption">
        <item name="android:textSize">12.5sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="YF.Button" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/btn_accent</item>
        <item name="android:textColor">@color/text_on_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="YF.Button.Ghost">
        <item name="android:background">@drawable/btn_ghost</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="YF.Button.Danger">
        <item name="android:background">@drawable/btn_danger</item>
        <item name="android:textColor">@color/text_on_accent</item>
    </style>

    <style name="YF.Input" parent="android:Widget.Material.EditText">
        <item name="android:background">@drawable/glass_input</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>

    <style name="YF.Label">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>

    <style name="YF.Chip">
        <item name="android:background">@drawable/chip</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>

    <style name="YF.Row">
        <item name="android:background">@drawable/row_bg</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="YF.Mono">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:textColor">@color/code_text</item>
    </style>
</resources>
