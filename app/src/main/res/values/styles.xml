<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Root of the YF.* family so every dotted style has an explicit, existing parent. -->
    <style name="YF" />

    <style name="YF.Glass">
        <item name="android:background">@drawable/glass_card</item>
        <item name="android:padding">18dp</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>

    <style name="YF.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="YF.Headline">
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="YF.Section">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/section_text</item>
        <item name="android:letterSpacing">0.007</item>
    </style>

    <style name="YF.RowTitle">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="YF.Body">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingExtra">5dp</item>
        <item name="android:letterSpacing">0.03</item>
    </style>

    <style name="YF.Caption">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="YF.Button" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/btn_accent</item>
        <item name="android:textColor">@color/text_on_accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="YF.Button.Ghost">
        <item name="android:background">@drawable/btn_ghost</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="YF.Button.Danger">
        <item name="android:background">@drawable/btn_danger</item>
        <item name="android:textColor">#FFFFFFFF</item>
    </style>

    <style name="YF.Input" parent="android:Widget.Material.EditText">
        <item name="android:background">@drawable/glass_input</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>

    <style name="YF.Label">
        <item name="android:textSize">13.5sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:layout_marginTop">14dp</item>
    </style>

    <style name="YF.Chip">
        <item name="android:background">@drawable/chip</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>

    <style name="YF.Row">
        <item name="android:background">@drawable/row_bg</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:minHeight">@dimen/row_min_height</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="YF.Mono">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/code_text</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="YF.Terminal">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/term_text</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="YF.DialogTitle" parent="android:TextAppearance.Material.DialogWindowTitle">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="YF.DialogButton" parent="android:Widget.Material.Button.Borderless.Colored">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15.5sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
