<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget, one row: "Ask …" (types), ask about the screen, talk. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/widget_bar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_margin="4dp"
        android:background="@drawable/widget_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_avatar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="10dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher_round" />

        <TextView
            android:id="@+id/widget_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/widget_hint_default"
            android:textColor="@color/widget_on_surface_2"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/widget_screen"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_button"
            android:contentDescription="@string/widget_ask_screen"
            android:padding="10dp"
            android:src="@drawable/ic_screen"
            android:tint="@color/widget_accent" />
        <ImageView
            android:id="@+id/widget_mic"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_button"
            android:contentDescription="@string/mic"
            android:padding="10dp"
            android:src="@drawable/ic_mic"
            android:tint="@color/widget_accent" />
    </LinearLayout>
</FrameLayout>
