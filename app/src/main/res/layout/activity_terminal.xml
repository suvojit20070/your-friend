<?xml version="1.0" encoding="utf-8"?>
<!-- Terminal in the Termux / Kali style: full black screen, session tabs, monospace output with
     colours, a two-line Kali prompt with the command line typed in place, and the Termux extra-keys rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/term_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0C0C0C"
    android:orientation="vertical">

    <include layout="@layout/top_bar" />

    <LinearLayout
        android:id="@+id/term_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Sessions (where commands run), like terminal tabs -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/term_backends"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Status line: where you are, and a spinner while something runs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/term_status"
                style="@style/YF.Terminal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textColor="#FF7D8794"
                android:textSize="11sp" />

            <com.google.android.material.loadingindicator.LoadingIndicator
                android:id="@+id/term_busy"
                style="@style/Widget.Material3.LoadingIndicator"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="12dp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Output, then the prompt and the command line right under it, all scrolling together
             like a real terminal (no separate input box). -->
        <ScrollView
            android:id="@+id/term_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbarSize="3dp"
            android:scrollbarThumbVertical="@drawable/term_scroll_thumb"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/term_page"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/term_output"
                    style="@style/YF.Terminal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="10dp"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="none"
                    android:lineSpacingExtra="1dp"
                    android:textIsSelectable="true"
                    android:textSize="12.5sp" />

                <!-- ┌──(user㉿yourfriend)-[path] -->
                <TextView
                    android:id="@+id/term_prompt"
                    style="@style/YF.Terminal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="10dp"
                    android:ellipsize="middle"
                    android:maxLines="1"
                    android:textSize="12.5sp" />

                <!-- └─$ command (typed in place; Enter runs it) -->
                <LinearLayout
                    android:id="@+id/term_line"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/term_dollar"
                        style="@style/YF.Terminal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:textSize="12.5sp" />

                    <EditText
                        android:id="@+id/term_input"
                        style="@style/YF.Terminal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:imeOptions="actionSend|flagNoExtractUi"
                        android:inputType="text|textNoSuggestions|textVisiblePassword"
                        android:padding="0dp"
                        android:textColor="#FFF2F2F2"
                        android:textColorHint="#FF5C6370"
                        android:textSize="12.5sp" />

                    <!-- Kept for the code (stop while a command runs); hidden: Enter runs, ^C stops. -->
                    <TextView
                        android:id="@+id/term_run"
                        style="@style/YF.Terminal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- Termux extra keys: two rows -->
    <LinearLayout
        android:id="@+id/term_keys"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF171717"
        android:orientation="vertical" />
</LinearLayout>
