<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Settings" android:textColor="@color/text" android:textSize="24sp"
            android:textStyle="bold" android:paddingBottom="16dp" />

        <TextView style="@style/Label" android:text="LLM provider (OpenAI-compatible)" />
        <EditText android:id="@+id/base" style="@style/Field" android:hint="Base URL — https://api.provider.ai/v1" />
        <EditText android:id="@+id/key" style="@style/Field" android:hint="API key" android:inputType="textPassword" />
        <EditText android:id="@+id/model" style="@style/Field" android:hint="Model name" />
        <CheckBox android:id="@+id/stream" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Streaming" android:textColor="@color/text" android:checked="true" />

        <TextView style="@style/Label" android:text="Web search (Tavily key, optional)" />
        <EditText android:id="@+id/tavilyKey" style="@style/Field" android:hint="TAVILY_KEY" android:inputType="textPassword" />

        <TextView style="@style/Label" android:text="Appearance" />
        <CheckBox android:id="@+id/dynamic" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Material You color (from wallpaper)" android:textColor="@color/text" android:checked="true" />
        <Button android:id="@+id/characterBtn" style="@style/Ghost" android:text="Character: Girl (tap to switch)" />

        <TextView style="@style/Label" android:text="Permissions (for device control)" />
        <Button android:id="@+id/accessBtn" style="@style/Ghost" android:text="Open Accessibility settings" />
        <Button android:id="@+id/overlayBtn" style="@style/Ghost" android:text="Allow display over apps" />

        <Button android:id="@+id/save" android:layout_width="match_parent" android:layout_height="52dp"
            android:layout_marginTop="20dp" android:text="Save" android:textStyle="bold"
            android:textColor="#0A0D18" android:background="@drawable/bg_send" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:textColor="@color/text_dim" android:textSize="11sp"
            android:text="Your Friend · built by Suvo (@suvojit20070). Credit required — see license." />
    </LinearLayout>
</ScrollView>
