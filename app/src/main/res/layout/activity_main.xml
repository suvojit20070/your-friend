<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Status row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/home_name"
                style="@style/YF.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/home_status"
                style="@style/YF.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="6dp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/home_settings"
            android:layout_width="@dimen/icon_button"
            android:layout_height="@dimen/icon_button"
            android:background="@drawable/circle_glass"
            android:contentDescription="@string/section_settings"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/home_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />
    </HorizontalScrollView>

    <!-- Companion area -->
    <FrameLayout
        android:id="@+id/companion_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false">

        <com.suvo.agent.character.CharacterView
            android:id="@+id/character"
            android:layout_width="300dp"
            android:layout_height="360dp"
            android:layout_gravity="bottom|center_horizontal" />

        <TextView
            android:id="@+id/speech_bubble"
            style="@style/YF.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginStart="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/speech_bubble"
            android:ellipsize="end"
            android:maxLines="6"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="18dp"
            android:paddingBottom="12dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/setup_banner"
            style="@style/YF.Glass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/YF.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/setup_banner_text"
                android:textStyle="bold" />

            <TextView
                style="@style/YF.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/setup_banner_detail" />

            <Button
                android:id="@+id/setup_banner_button"
                style="@style/YF.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:tag="accent"
                android:text="@string/setup_banner_action" />
        </LinearLayout>
    </FrameLayout>

    <!-- Input bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/glass_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <ImageButton
            android:id="@+id/home_mic"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/circle_accent"
            android:contentDescription="@string/mic"
            android:src="@drawable/ic_mic"
            android:tag="accent"
            android:tint="@color/text_on_accent" />

        <EditText
            android:id="@+id/home_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/home_input_hint"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary" />

        <ImageButton
            android:id="@+id/home_send"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/circle_glass"
            android:contentDescription="@string/send"
            android:src="@drawable/ic_send" />
    </LinearLayout>

    <!-- Floating pill navigation -->
    <LinearLayout
        android:id="@+id/nav"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nav_height"
        android:layout_margin="12dp"
        android:background="@drawable/glass_pill"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp" />
</LinearLayout>
