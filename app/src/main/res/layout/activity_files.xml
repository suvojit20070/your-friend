<?xml version="1.0" encoding="utf-8"?>
<!-- Files: top bar, the list (pull down to refresh), and the selection / paste bar at the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/top_bar" />

    <com.suvo.agent.ui.widgets.FasterPullToRefreshLayout
        android:id="@+id/files_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/rows_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fadingEdgeLength="24dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_padding"
                android:paddingTop="4dp"
                android:paddingEnd="@dimen/screen_padding"
                android:paddingBottom="40dp" />
        </ScrollView>
    </com.suvo.agent.ui.widgets.FasterPullToRefreshLayout>

    <LinearLayout
        android:id="@+id/files_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/screen_padding"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone" />
</LinearLayout>
