<?xml version="1.0" encoding="utf-8"?>
<!-- One chat row; ChatActivity aligns it left/right and picks the bubble per message type. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/msg_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <LinearLayout
        android:id="@+id/msg_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/msg_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/msg_title"
                style="@style/YF.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Accordion arrow: points right when closed, down when open -->
            <ImageView
                android:id="@+id/msg_chevron"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:rotation="0"
                android:src="@drawable/ic_chevron"
                android:tint="@color/text_secondary"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/msg_text"
            style="@style/YF.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textIsSelectable="false"
            android:breakStrategy="simple"
            android:hyphenationFrequency="none" />

        <TextView
            android:id="@+id/msg_detail"
            style="@style/YF.Mono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/code_bg"
            android:padding="10dp"
            android:visibility="gone" />

        <!-- Tools used in this step: rows that open into their own code box -->
        <LinearLayout
            android:id="@+id/msg_tools"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Small action icons under a message (copy, more): no long-press needed. -->
    <LinearLayout
        android:id="@+id/msg_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/msg_copy"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@null"
            android:contentDescription="@string/copy"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_copy"
            android:tint="@color/text_secondary" />

        <ImageButton
            android:id="@+id/msg_more"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="2dp"
            android:background="@null"
            android:contentDescription="@string/more"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_more"
            android:tint="@color/text_secondary" />
    </LinearLayout>

    <TextView
        android:id="@+id/msg_time"
        style="@style/YF.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="2dp"
        android:textSize="11sp" />
</LinearLayout>
