<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Launch screen (Android 12+): the page colour of the app's own theme. The app picks one of
        these with SplashScreen.setSplashScreenTheme (Android 13+) when the accent or theme changes,
        and tells Android its light / dark mode (UiModeManager.setApplicationNightMode), so
        @color/splash_* resolves to the right side. Dim is pure black.
    -->
    <style name="Theme.YourFriend.Splash.S0" parent="Theme.YourFriend">
        <item name="android:windowSplashScreenBackground">@color/splash_s0</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_name</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>
