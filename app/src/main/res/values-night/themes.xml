<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.YourFriend" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_app</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:alertDialogTheme">@style/Theme.YourFriend.Dialog</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:colorControlNormal">@color/text_secondary</item>
        <item name="android:colorControlHighlight">@color/accent_soft</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:colorBackground">@color/bg_top</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Material 3 colour roles (MaterialSwitch, Slider) follow the app accent. -->
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/text_on_accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOutline">@color/switch_thumb_off</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <!-- Text selection handles in the accent colour -->
        <item name="android:textSelectHandle">@drawable/text_select_handle</item>
        <item name="android:textSelectHandleLeft">@drawable/text_select_handle_left</item>
        <item name="android:textSelectHandleRight">@drawable/text_select_handle_right</item>
        <item name="android:textColorHighlight">@color/accent_soft</item>
    </style>

    <style name="Theme.YourFriend.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:colorControlNormal">@color/text_secondary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorAlertDialogListItem">@color/text_primary</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:windowBackground">@drawable/glass_dialog</item>
        <item name="android:windowTitleStyle">@style/YF.DialogTitle</item>
        <item name="android:buttonBarButtonStyle">@style/YF.DialogButton</item>
        <item name="android:backgroundDimAmount">0.55</item>
    </style>
</resources>
