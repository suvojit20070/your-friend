{
  "name": "web_search",
  "description": "Search the web and return top results for a query. Use for current info.",
  "danger": "low",
  "enabled": true,
  "action": {
    "type": "http",
    "method": "POST",
    "url": "https://api.tavily.com/search",
    "headers": { "Content-Type": "application/json" },
    "body": "{\"api_key\":\"{{secret.TAVILY_KEY}}\",\"query\":\"{{query}}\",\"max_results\":5}",
    "pick": "results"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "query": { "type": "string", "description": "What to search for" }
    },
    "required": ["query"]
  }
}
