{
  "name": "open_url",
  "description": "Open a website or app link on the device.",
  "danger": "low",
  "enabled": true,
  "action": {
    "type": "intent",
    "intentAction": "android.intent.action.VIEW",
    "data": "{{url}}"
  },
  "parameters": {
    "type": "object",
    "properties": {
      "url": { "type": "string", "description": "The https URL to open" }
    },
    "required": ["url"]
  }
}
